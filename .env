# ── Сервер ──────────────────────────────────
PORT=8080

# ── Источник данных ──────────────────────────
# "csv" — читать из CSV (сейчас)
# "oracle" — читать из Oracle MANDATORY_ACCESS_LOGS (раскомментировать когда готово)
DATA_SOURCE=csv
CSV_PATH=data/TRANSFORMED_ACCESS_LOG_2.csv
ENRICHED_PATH=data/enriched_log.csv

# Путь к enriched_log.csv — передаётся в ML-сервис для пересчёта профилей
# Должен совпадать с ENRICHED_PATH выше (абсолютный путь если сервисы в разных папках)
ENRICHED_CSV_PATH=data/enriched_log.csv

# Oracle (заполнить при переходе на БД)
# ORACLE_DSN=user/password@host:1521/ORCL

# PostgreSQL (своя БД для обогащённых событий, опционально)
# POSTGRES_DSN=postgres://user:pass@localhost:5432/anomaly_monitor?sslmode=disable

# ── ML-сервис ────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_THRESHOLD=0.89

# ── Polling (как часто читать новые события) ─
POLLING_INTERVAL_SEC=30

# ── Email уведомления ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@gmail.com

# ── Настройки алертов ────────────────────────
ALERT_THRESHOLD=0.89
ALERT_RECIPIENTS=admin@company.ru,security@company.ru
